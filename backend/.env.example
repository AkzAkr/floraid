# FloraID Backend Environment Variables
# Copy this file to .env and update values

# ==========================================================================
# Server Configuration
# ==========================================================================
PORT=8000
HOST=0.0.0.0
DEBUG=false
LOG_LEVEL=info

# ==========================================================================
# Model Configuration
# ==========================================================================
# Path to trained model file (relative to backend/ or absolute)
MODEL_PATH=models/efficientnetb0_flowers102_clean.keras

# Path to class indices JSON
CLASS_INDICES_PATH=models/class_indices.json

# ==========================================================================
# API Limits
# ==========================================================================
# Maximum upload image size (bytes)
MAX_IMAGE_SIZE=5242880

# Rate limit per client (format: requests/time)
RATE_LIMIT=10/minute

# ==========================================================================
# External APIs (Optional)
# ==========================================================================
# Perenual API key for plant care data
# Get free key at: https://perenual.com/docs/api
PERENUAL_API_KEY=your_perenual_api_key_here

# Wikipedia/GBIF don't require API keys

# ==========================================================================
# CORS (Update in production)
# ==========================================================================
# Comma-separated list of allowed origins
# Use "*" for development only
CORS_ORIGINS=*

# ==========================================================================
# Monitoring (Optional)
# ==========================================================================
# Enable Prometheus metrics
# ENABLE_METRICS=false
# METRICS_PORT=9090
